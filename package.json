{
  "name": "m3-docs-mcp",
  "version": "0.1.0",
  "description": "MCP server that serves locally cached Material 3 documentation from m3.material.io",
  "type": "module",
  "bin": {
    "m3-docs-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:mutation:shards:check": "node scripts/run-mutation-shards.mjs check",
    "test:mutation:shard": "node scripts/run-mutation-shards.mjs shard",
    "test:mutation:aggregate": "node scripts/run-mutation-shards.mjs aggregate",
    "test:mutation:json-extraction": "stryker run stryker-json-extraction.config.json",
    "test:mutation:full": "stryker run",
    "verify:docs-values": "vitest run tests/docs-values.test.ts",
    "inspect:site-data": "npm run build && node scripts/inspect-site-data.mjs",
    "verify:update-smoke": "npm run verify:cache:smoke",
    "verify:cache:smoke": "npm run build && node scripts/verify-full-cache-refresh.mjs --smoke",
    "verify:cache:full": "npm run build && node scripts/verify-full-cache-refresh.mjs",
    "start": "node dist/index.js serve",
    "crawl": "node dist/index.js update"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "commander": "^12.1.0",
    "es-toolkit": "^1.47.1",
    "minisearch": "^7.1.2",
    "playwright": "^1.53.0",
    "turndown": "^7.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.1.1",
    "@stryker-mutator/vitest-runner": "^9.1.1",
    "@types/node": "^22.15.0",
    "@types/turndown": "^5.0.5",
    "@vitest/coverage-v8": "^3.2.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vyachean/m3-docs-mcp.git"
  },
  "keywords": [
    "mcp",
    "material-design",
    "material-3",
    "playwright",
    "documentation"
  ]
}
