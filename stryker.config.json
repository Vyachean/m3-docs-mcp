{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "packageManager": "npm",
  "reporters": ["progress", "clear-text"],
  "mutate": [
    "src/cache.ts",
    "src/crawler-utils.ts",
    "src/store.ts",
    "!src/index.ts",
    "!src/mcp-server.ts",
    "!src/crawler.ts"
  ],
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 80,
    "low": 70,
    "break": 65
  },
  "vitest": {
    "configFile": "vitest.config.ts"
  }
}
